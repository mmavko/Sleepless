#!/usr/bin/env bash
# sleepless — command line for the keep-awake lease.
#
#   sleepless extend [duration]   push the lease out to now + duration (never shortens)
#   sleepless status              what the Mac is doing and why
#   sleepless hook [--install|--remove]
#                                 check, add or remove the Claude Code PreToolUse hook
#   sleepless report              what past keep-awake sessions actually did (heat, battery)
#   sleepless off                 restore normal sleep now
#   sleepless release             drop the lease only; the watchdog turns it off next tick
#
# Duration: bare seconds, or 90s / 20m / 2h. With no duration, `extend` reads the app's
# "stop after N minutes of no tool calls" setting, so the UI stays the single source of truth.
#
# THIS IS THE HOOK COMMAND. A Claude Code PreToolUse hook running `sleepless extend` is the
# whole integration: tool activity is the heartbeat, and its absence is the signal to stop.
# See docs/LEASE-DESIGN.md.
#
# `extend` NEVER arms keep-awake, only prolongs it. Arming stays a deliberate act at the
# menu-bar switch — otherwise any Claude session anywhere would silently disable your Mac's
# sleep. The lease is INTENT, never state: writing one cannot keep the Mac awake, it only
# tells the watchdog not to take it away yet.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=leaselib.sh
. "$SCRIPT_DIR/leaselib.sh"

BUNDLE_ID="com.aboudjem.Sleepless"
# Test seam. `defaults` talks to cfprefsd and ignores HOME, so the self-test cannot sandbox
# the preference domain with a fake home the way it does the lease file — it needs this.
# Honoured only under SLEEPLESS_SELFTEST=1, so a stray variable can't redirect the real CLI.
if [ "${SLEEPLESS_SELFTEST:-}" = "1" ] && [ -n "${SLEEPLESS_DEFAULTS_DOMAIN:-}" ]; then
  BUNDLE_ID="$SLEEPLESS_DEFAULTS_DOMAIN"
fi
FALLBACK_IDLE_MINUTES=20
PMSET=/usr/bin/pmset

# Quiet when piped (a hook shouldn't chatter into the transcript), chatty at a terminal.
say() { [ -t 1 ] && printf '%s\n' "$*" || true; }

# seconds | 90s | 20m | 2h  ->  seconds
parse_duration() {
  local raw="$1" n unit
  n="${raw%[smh]}"; unit="${raw#"$n"}"
  case "$n" in ''|*[!0-9]*) return 1 ;; esac
  case "$unit" in
    ''|s) echo "$n" ;;
    m)    echo $((n * 60)) ;;
    h)    echo $((n * 3600)) ;;
    *)    return 1 ;;
  esac
}

# The UI owns this number; the CLI just reads it. Unset/garbage falls back rather than failing:
# a hook that errors out is noise, and the safety nets bound the damage either way.
default_ttl_seconds() {
  local minutes
  minutes="$(defaults read "$BUNDLE_ID" idleTimeoutMinutes 2>/dev/null || true)"
  case "$minutes" in
    ''|*[!0-9]*) minutes="$FALLBACK_IDLE_MINUTES" ;;
  esac
  [ "$minutes" -ge 1 ] 2>/dev/null || minutes="$FALLBACK_IDLE_MINUTES"
  echo $((minutes * 60))
}

flag_is_set() {
  "$PMSET" -g 2>/dev/null | awk '
    tolower($0) ~ /sleepdisabled/ { v = $NF }
    END { exit (v == "1") ? 0 : 1 }'
}

cmd_extend() {
  local ttl now target current
  if [ -n "${1:-}" ]; then
    ttl="$(parse_duration "$1")" || { echo "error: bad duration '$1' (use 90, 90s, 20m, 2h)" >&2; exit 64; }
  else
    ttl="$(default_ttl_seconds)"
  fi
  if [ "$ttl" -lt 1 ] || [ "$ttl" -gt "$MAX_LEASE_HORIZON" ]; then
    echo "error: duration must be between 1s and ${MAX_LEASE_HORIZON}s" >&2; exit 64
  fi

  now="$(date +%s)"
  target=$((now + ttl))
  # A floor, not an assignment: a short renewal must never truncate a longer live lease.
  # This is also what makes parallel Claude sessions work with ONE lease file and no
  # locking — everyone extends, nobody releases, so it lapses after the last one goes quiet.
  current="$(live_expiry)"
  if [ -n "$current" ] && [ "$current" -gt "$target" ]; then target="$current"; fi

  mkdir -p "$(dirname "$LEASE_FILE")"
  local tmp; tmp="$(mktemp "$(dirname "$LEASE_FILE")/.lease.XXXXXX")"
  trap 'rm -f "$tmp"' EXIT
  printf 'version=%s\nexpires=%s\nboot=%s\n' "$LEASE_VERSION" "$target" "$(boot_time)" > "$tmp"
  chmod 0600 "$tmp"
  mv -f "$tmp" "$LEASE_FILE"    # write-then-rename: never a half-written lease
  trap - EXIT
  say "lease held for $((target - now))s (until $(date -r "$target" '+%H:%M:%S'))"
}

cmd_release() {
  rm -f "$LEASE_FILE"
  say "lease released; the watchdog restores normal sleep within one tick"
}

cmd_off() {
  rm -f "$LEASE_FILE"
  if ! flag_is_set; then echo "already off; normal sleep is in effect"; return 0; fi
  if /usr/bin/sudo -n "$PMSET" -a disablesleep 0 2>/dev/null; then
    echo "off; normal sleep restored"
  else
    echo "error: couldn't clear disablesleep (is the grant installed? run ./grant.sh)" >&2
    echo "       the lease is released, so the watchdog will clear it within one tick." >&2
    exit 1
  fi
}

# Is a PreToolUse hook actually calling us? Without one the idle timeout never sees a tool
# call, so it would turn keep-awake off on schedule no matter how hard Claude is working.
# Only user-level settings can be checked from here; project-level ones live in whatever
# repo you happen to be in, so a "not found" is a reminder, never an error.
HOOK_FILES=("$HOME/.claude/settings.json" "$HOME/.claude/settings.local.json")

hook_installed_in() {
  /usr/bin/python3 - "$1" <<'PY' 2>/dev/null
import json, sys
try:
    with open(sys.argv[1]) as f:
        data = json.load(f)
except Exception:
    sys.exit(1)
entries = (data.get("hooks") or {}).get("PreToolUse") or []
for entry in entries:
    for hook in (entry.get("hooks") or []):
        command = " ".join([str(hook.get("command", ""))] + [str(a) for a in (hook.get("args") or [])])
        if "sleepless" in command and "extend" in command:
            sys.exit(0)
sys.exit(1)
PY
}

hook_location() {
  local f
  for f in "${HOOK_FILES[@]}"; do
    [ -f "$f" ] || continue
    if hook_installed_in "$f"; then echo "$f"; return 0; fi
  done
  return 1
}

USER_SETTINGS="$HOME/.claude/settings.json"

# Add or remove our PreToolUse entry in the user's settings.json, MERGING rather than
# overwriting: this file belongs to Claude Code and to every other tool the user has set up
# there, so it is backed up first, edited through a JSON round-trip, validated by re-parsing,
# and moved into place atomically. Refuses rather than guesses if the file is not valid JSON.
edit_user_hook() {
  /usr/bin/python3 - "$USER_SETTINGS" "$1" "$SCRIPT_DIR/sleepless extend" <<'PY'
import json, os, shutil, sys, time

path, action, command = sys.argv[1], sys.argv[2], sys.argv[3]

data = {}
if os.path.exists(path) and os.path.getsize(path) > 0:
    try:
        with open(path) as handle:
            data = json.load(handle)
    except ValueError as exc:
        print("error: %s is not valid JSON (%s)." % (path, exc), file=sys.stderr)
        print("       Refusing to touch it. Add or remove the hook by hand.", file=sys.stderr)
        sys.exit(2)
if not isinstance(data, dict):
    print("error: %s is not a JSON object. Refusing to touch it." % path, file=sys.stderr)
    sys.exit(2)

def is_ours(hook):
    text = " ".join([str(hook.get("command", ""))] + [str(a) for a in (hook.get("args") or [])])
    return "sleepless" in text and "extend" in text

hooks = data.setdefault("hooks", {})
entries = hooks.setdefault("PreToolUse", [])
present = any(is_ours(h) for e in entries for h in (e.get("hooks") or []))

if action == "--install":
    if present:
        print("already installed; nothing to do.")
        sys.exit(0)
    entries.append({"hooks": [{"type": "command", "command": command}]})
else:
    if not present:
        print("no sleepless hook present; nothing to remove.")
        sys.exit(0)
    for entry in entries:
        entry["hooks"] = [h for h in (entry.get("hooks") or []) if not is_ours(h)]
    hooks["PreToolUse"] = [e for e in entries if e.get("hooks")]
    # Leave no empty scaffolding behind that we created.
    if not hooks["PreToolUse"]:
        del hooks["PreToolUse"]
    if not hooks:
        del data["hooks"]

if os.path.exists(path):
    backup = "%s.sleepless-backup-%d" % (path, int(time.time()))
    shutil.copy2(path, backup)
    print("backed up to %s" % backup)

os.makedirs(os.path.dirname(path), exist_ok=True)
tmp = path + ".sleepless-tmp"
with open(tmp, "w") as handle:
    json.dump(data, handle, indent=2)
    handle.write("\n")
with open(tmp) as handle:          # re-parse before it replaces anything real
    json.load(handle)
os.replace(tmp, path)
print("%s %s" % ("installed into" if action == "--install" else "removed from", path))
PY
}

cmd_hook() {
  case "${1:-}" in
    --install)
      edit_user_hook --install || return $?
      echo "   Claude Code tool calls (including subagents') will now extend the lease."
      echo "   Already-running sessions pick this up without a restart."
      return 0
      ;;
    --remove)
      edit_user_hook --remove
      return $?
      ;;
  esac

  local found
  if found="$(hook_location)"; then
    echo "✅ PreToolUse hook found in $found"
    echo "   Claude Code tool calls (including subagents') will extend the lease."
    return 0
  fi
  cat <<HOOKEOF
⚠️  No PreToolUse hook found in ~/.claude/settings.json.

Without it, "Stop when Claude Code goes idle" falls back to watching Claude Code transcript
mtimes under ~/.claude/projects. That works with no setup, but it is coarser: it sees that
Claude did something, not what. The hook is precise and worth adding — put this in
~/.claude/settings.json (all sessions on this Mac) or a project's .claude/settings.json:

  {
    "hooks": {
      "PreToolUse": [
        { "hooks": [{ "type": "command", "command": "$SCRIPT_DIR/sleepless extend" }] }
      ]
    }
  }

Project-level settings can't be checked from here, so ignore this if you set it up there.
HOOKEOF
  return 1
}

# The session journal is instrumentation, not a safety net. Thermal protection is the one
# net whose thresholds we would be guessing at, so instead of guessing, the app records what
# really happens and this reports it. The point of the report is to answer one question:
# is there enough evidence yet to build the real thermal net, and with what numbers?
# Summaries only. They are the corpus and are never rotated — the rare session that cooked in
# a bag is exactly what a size cap would throw away first. The bulky per-minute samples live in
# samples.jsonl and rotate on their own.
JOURNAL="$SUPPORT_DIR/sessions.jsonl"

cmd_report() {
  critical_note || true
  /usr/bin/python3 - "$JOURNAL" <<'PY'
import json, os, sys

paths = [p for p in (sys.argv[1], sys.argv[1] + ".1") if os.path.exists(p)]
if not paths:
    print("No session journal yet. It is written while keep-awake is ON.")
    print("Turn Sleepless on, use the Mac, turn it off — then run this again.")
    sys.exit(0)

summaries = []
for path in paths:
    with open(path) as handle:
        for line in handle:
            try:
                row = json.loads(line)
            except ValueError:
                continue
            if row.get("ev") == "summary":
                summaries.append(row)

if not summaries:
    print("Journal exists but no completed keep-awake sessions yet.")
    sys.exit(0)

RANK = {"nominal": 0, "fair": 1, "serious": 2, "critical": 3}
total_sec = sum(s.get("durationSec", 0) for s in summaries)
hot = [s for s in summaries if RANK.get(s.get("maxThermal", "nominal"), 0) >= 2]
# The risky shape is heat with the lid CLOSED. A warm Mac on a desk is just a working Mac.
closed = [s for s in summaries if s.get("lidClosedSamples", 0) > 0]
hot_closed = [s for s in hot if s.get("lidClosedSamples", 0) > 0]
battery_sessions = [s for s in summaries if s.get("onBatterySamples", 0) > 0]

print("Keep-awake sessions recorded: %d (%.1f h total)" % (len(summaries), total_sec / 3600.0))
print("  with the lid closed at some point: %d" % len(closed))
print("  on battery at some point:          %d" % len(battery_sessions))
print("")
print("Heat reached (max thermal state per session):")
for name in ("nominal", "fair", "serious", "critical"):
    n = sum(1 for s in summaries if s.get("maxThermal") == name)
    if n:
        print("  %-9s %d" % (name, n))

if battery_sessions:
    drops = sorted((s.get("batteryDropPct", 0) for s in battery_sessions), reverse=True)
    print("")
    print("Battery used per session on battery: worst %d%%, median %d%%"
          % (drops[0], drops[len(drops) // 2]))

print("")
if hot_closed:
    print("⚠️  %d session(s) got to serious/critical heat WITH THE LID CLOSED:" % len(hot_closed))
    for s in sorted(hot_closed, key=lambda x: -RANK.get(x.get("maxThermal", "nominal"), 0))[:5]:
        print("    %s for %d min, ended: %s"
              % (s.get("maxThermal"), s.get("durationSec", 0) // 60, s.get("reason", "?")))
    print("")
    print("    This is the case a real thermal net would exist to catch. There is now")
    print("    evidence to set its thresholds from, rather than guessing them.")
elif hot:
    print("Some sessions got warm, but never with the lid closed — that is a working Mac,")
    print("not a Mac cooking in a bag. Not yet evidence for a thermal net.")
else:
    print("No session has reached serious heat yet.")
    if not closed:
        print("Note: no session has run with the lid closed, which is the only risky shape.")
        print("Until that changes, this corpus cannot say the design is safe — only untested.")
PY
}

# A critical-heat event is recorded where it survives the notification, because you were
# probably not at the Mac when it fired. Ages out after a day.
critical_note() {
  local at lid age
  at="$(defaults read "$BUNDLE_ID" lastCriticalAt 2>/dev/null || true)"
  case "$at" in ''|*[!0-9.]*) return 1 ;; esac
  at="${at%%.*}"
  age=$(( $(date +%s) - at ))
  [ "$age" -ge 0 ] && [ "$age" -lt 86400 ] || return 1
  lid="$(defaults read "$BUNDLE_ID" lastCriticalLidClosed 2>/dev/null || echo 0)"
  if [ "$lid" = "1" ]; then
    echo "⚠️  Hit CRITICAL heat $((age / 60)) min ago, with the lid closed."
  else
    echo "⚠️  Hit CRITICAL heat $((age / 60)) min ago (lid open)."
  fi
}

# How the last keep-awake session ended. Worth showing at a terminal for the same reason the
# app shows it in the popover: the notification fired while the lid was shut.
last_session_note() {
  local ended dur reason age
  ended="$(defaults read "$BUNDLE_ID" lastSessionEndedAt 2>/dev/null || true)"
  case "$ended" in ''|*[!0-9.]*) return 1 ;; esac
  ended="${ended%%.*}"
  age=$(( $(date +%s) - ended ))
  [ "$age" -ge 0 ] && [ "$age" -lt 21600 ] || return 1
  dur="$(defaults read "$BUNDLE_ID" lastSessionDurationSec 2>/dev/null || echo 0)"
  reason="$(defaults read "$BUNDLE_ID" lastSessionReason 2>/dev/null || echo '?')"
  case "$reason" in
    switch)   reason="you turned it off" ;;
    quit)     reason="Sleepless quit" ;;
    external) reason="the watchdog stepped in" ;;
    crash)    reason="Sleepless stopped unexpectedly; the watchdog restored sleep" ;;
  esac
  printf 'last run:    kept awake %d min, then off: %s\n' "$(( dur / 60 ))" "$reason"
}

cmd_status() {
  local state
  if flag_is_set; then
    echo "keep-awake: ON  (lid close will not sleep this Mac)"
  else
    echo "keep-awake: off (normal sleep)"
  fi

  state="$(lease_state)"
  case "$state" in
    live\ *) echo "lease:      live, $(( ${state#live } - $(date +%s) ))s left" ;;
    dead\ *) echo "lease:      none (${state#dead })" ;;
  esac

  if launchctl list com.aboudjem.Sleepless.watchdog >/dev/null 2>&1; then
    echo "watchdog:   running"
  else
    echo "watchdog:   NOT RUNNING — a crash would leave this Mac awake until reboot"
  fi

  # -n never prompts, -l never executes: this asks whether the grant exists, it does not use it.
  if /usr/bin/sudo -n -l /usr/bin/pmset -a disablesleep 0 >/dev/null 2>&1; then
    echo "grant:      installed"
  else
    echo "grant:      MISSING — run ./grant.sh once, or the switch cannot work"
  fi

  local found
  if found="$(hook_location)"; then
    echo "claude hook: installed ($found)"
  else
    echo "claude hook: not in user settings — run 'sleepless hook' (may be set per-project)"
  fi
  last_session_note || true
  critical_note || true
  flag_is_set
}

case "${1:-}" in
  extend)  cmd_extend "${2:-}" ;;
  release) cmd_release ;;
  off)     cmd_off ;;
  status)  cmd_status ;;
  hook)    cmd_hook "${2:-}" ;;
  report)  cmd_report ;;
  -h|--help|help)
    sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *) echo "usage: sleepless extend [duration] | status | hook [--install|--remove] | report | off | release" >&2; exit 64 ;;
esac
